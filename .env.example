# ====================================================================
# Configuration for India Professional Email Lead Finder
# ====================================================================

# 1. LinkedIn Direct Login / Session Automation
# Option A: Email and Password for automatic login
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Option B (Safest): li_at session cookie from your browser
# To get it: Open LinkedIn in Chrome -> Press F12 -> Application tab -> Cookies -> Copy 'li_at'
LINKEDIN_LI_AT=

# 2. Google Programmable Search (100 free searches/day)
# Optional alternative if not using direct LinkedIn login
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 3. Email Verification APIs (Optional - Local MX & SMTP verification are free & unlimited)
HUNTER_API_KEY=
SNOV_API_KEY=
SNOV_API_SECRET=

# 4. Apollo.io Search API (Optional)
APOLLO_API_KEY=
